    BaseType == "Sekhema Sandals" "Sandsworn Sandals" "Daggerfoot Shoes" "Quickslip Shoes" "Drakeskin Boots"
    SetFontSize 45
    SetTextColor 255 0 0 255
	SetBorderColor 255 0 0 255
	SetBackgroundColor 255 255 255 255
    PlayAlertSound 1 150
    PlayEffect Red
    MinimapIcon 0 Red Square
Show
    Corrupted False
    # ItemLevel >= 82
    Sockets >= 2
    Rarity Normal Magic Rare
    Class == "Boots"
    BaseType == "Sekhema Sandals" "Sandsworn Sandals" "Luxurious Slippers" "Bound Sandals" "Daggerfoot Shoes" "Quickslip Shoes" "Charmed Shoes" "Wanderer Shoes" "Tasalian Greaves" "Vaal Greaves" "Ornate Greaves" "Bulwark Greaves" "Drakeskin Boots" "Dragonscale Boots" "Cavalry Boots" "Cinched Boots" "Cryptic Leggings" "Warlock Leggings" "Apostle Leggings" "Faithful Leggings" "Blacksteel Sabatons" "Fortress Sabatons" "Noble Sabatons" "Veteran Sabatons"
    SetFontSize 45
    SetTextColor 255 0 0 255
	SetBorderColor 255 0 0 255
	SetBackgroundColor 255 255 255 255
    PlayAlertSound 6 300
    PlayEffect Red
    MinimapIcon 1 Red Square

#===============================================================================================================
# [0023] Oversocket - All (safeguard)
#===============================================================================================================

Show # %D5 $type->uniques $tier->oversockt_3s_all !exotics_artifacthigh
    Corrupted False
    # ItemLevel >= 82
    DropLevel >= 65
	Sockets >= 3
	Rarity Normal Magic Rare
	Class == "Body Armours" "Bows" "Crossbows" "Quarterstaves" "Flails" "Talismans" "Two Hand Axes" "Two Hand Maces" "Two Hand Swords" "Staves"
    SetFontSize 30
    SetTextColor 0 0 255 255
	SetBorderColor 0 0 255 255
	SetBackgroundColor 255 255 255 255
    PlayAlertSound 2 300
    PlayEffect Yellow
    MinimapIcon 2 Yellow Square

Show # %D5 $type->uniques $tier->oversockt_2s_all !exotics_artifacthigh
    Corrupted False
    # ItemLevel >= 82
    DropLevel >= 65
    Sockets >= 2
	Rarity Normal Magic Rare
	Class == "Helmets" "Gloves" "Boots" "Claws" "Daggers" "Spears" "One Hand Axes" "One Hand Maces" "One Hand Swords" "Sceptres" "Wands" "Bucklers" "Foci" "Shields"
	SetFontSize 30
    SetTextColor 0 0 255 255
	SetBorderColor 0 0 255 255
	SetBackgroundColor 255 255 255 255
    PlayAlertSound 2 300
    PlayEffect Yellow
    MinimapIcon 2 Yellow Square

#===============================================================================================================
# [0024] Overquality
#===============================================================================================================

Show
    Quality > 20
    Rarity Normal Magic Rare
    SetFontSize 42
    DropLevel >= 65
    SetTextColor 0 0 255 255
	SetBorderColor 0 0 255 255
	SetBackgroundColor 255 255 255 255
    PlayEffect White Temp
    MinimapIcon 2 White Square

