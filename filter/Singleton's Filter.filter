# [ One Hand Axes ]
# 1 
# 2 
# 3 
# [ Two Hand Axes ]
# 1 
# 2 
# 3 

# [ One Hand Mace ]
# 1 "Akoyan Club" "Marauding Mace" "Molten Hammer"
# 2
Show
    Corrupted False
    # ItemLevel >= 82
    Sockets >= 2
    Rarity Normal Magic Rare
    Class == "One Hand Maces" 
    # BaseType == "Akoyan Club" "Marauding Mace" "Molten Hammer"
    SetFontSize 45
    SetTextColor 255 0 0 255
	SetBorderColor 255 0 0 255
	SetBackgroundColor 255 255 255 255
    PlayAlertSound 6 300
    PlayEffect Red
    MinimapIcon 1 Red Square

# [ Two Hand Mace ]
# 1 "Massive Greathammer"
# 2 "Tawhoan Greatclub" "Ironwood Greathammer"
# 3 "Sacred Maul"
Show
    Corrupted False
    # ItemLevel >= 82
    Sockets >= 3
    Rarity Normal Magic Rare
    BaseType == "Massive Greathammer" "Ironwood Greathammer"
    SetFontSize 45
    SetTextColor 255 0 0 255
	SetBorderColor 255 0 0 255
	SetBackgroundColor 255 255 255 255
    PlayAlertSound 6 300
    PlayEffect Red
    MinimapIcon 1 Red Square

